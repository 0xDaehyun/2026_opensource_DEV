{
  "tr": "t0425",
  "source": "LS 공식 API 콘솔 (2026-08-22 확인, 계좌번호·토큰 없음 — 민감 정보 없음)",
  "endpoint": {
    "method": "POST",
    "path": "/stock/accno",
    "note": "t0424(잔고 조회)와 같은 경로다. LsController는 URL이 아니라 InBlock 이름으로 TR을 구분하므로 코드 변경은 필요 없다."
  },
  "request": {
    "type": "json-body",
    "inBlockName": "t0425InBlock",
    "note": "우리가 추정했던 'OrdNo(단일 주문번호로 조회)'가 아니라, 종목코드 기준 주문 목록 조회다. 연속조회(cts_ordno)로 페이지네이션한다.",
    "fields": {
      "expcode": "string (종목코드)",
      "chegb": "string (체결구분: 0=전체 등)",
      "medosu": "string (매도수구분: 0=전체 등)",
      "sortgb": "string (정렬구분)",
      "cts_ordno": "string (연속조회 주문번호, 첫 조회는 공백)"
    },
    "sample": {
      "expcode": "005930",
      "chegb": "0",
      "medosu": "0",
      "sortgb": "2",
      "cts_ordno": " "
    }
  },
  "response": {
    "type": "json-body",
    "note": "t0425OutBlock1은 배열(주문 목록), t0425OutBlock은 합계 object다. 우리가 짐작했던 단일 주문 조회 응답 모양이 아니다.",
    "outBlock1ItemFields": {
